# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT signing secret (generate a strong random 32+ character value)
JWT_SECRET=replace-with-a-long-random-secret

# Public app URL used for redirects and absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Cloudinary configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth credentials. Register this exact redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/google/callback (use your production app URL in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runtime/session settings
NODE_ENV=development
SESSION_MAX_AGE_DAYS=7
SESSION_REFRESH_AFTER_DAYS=6
SESSION_BIND_IP=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
